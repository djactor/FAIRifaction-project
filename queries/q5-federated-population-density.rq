# LINKING POINT 1 (Wikidata, via owl:sameAs on cities)
# Question not answerable with our data alone:
#   What was the population DENSITY (inhabitants per km2) of each city proper in its latest observation?
# The area (P2046) comes from Wikidata. 
PREFIX ont:  <https://w3id.org/FAIR-course-UT/2026/groupNN/ont#>
PREFIX data: <https://w3id.org/FAIR-course-UT/2026/groupNN/data#>
PREFIX qb:   <http://purl.org/linked-data/cube#>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX schema: <https://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd:   <http://www.bigdata.com/rdf#>

SELECT ?city ?year ?population ?areaKm2 (ROUND(?population / ?areaKm2) AS ?inhabitantsPerKm2)
WHERE {
  ?obs ont:city ?c ; ont:cityType ont:CityProper ; sdmx-dimension:refPeriod ?year ; ont:population ?population .
  FILTER NOT EXISTS { ?n ont:city ?c ; ont:cityType ont:CityProper ; sdmx-dimension:refPeriod ?y2 . FILTER (xsd:integer(STR(?y2)) > xsd:integer(STR(?year))) }
  ?c rdfs:label ?city ; owl:sameAs ?wd .
  SERVICE <https://query.wikidata.org/sparql> {
    ?wd wdt:P2046 ?areaKm2 .
  }
}
ORDER BY DESC(?inhabitantsPerKm2)
