# CQ1: What was the population of each city proper in the 2011 census, largest first?
PREFIX ont:  <https://w3id.org/FAIR-course-UT/2026/groupNN/ont#>
PREFIX data: <https://w3id.org/FAIR-course-UT/2026/groupNN/data#>
PREFIX qb:   <http://purl.org/linked-data/cube#>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX schema: <https://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?country ?city ?population
WHERE {
  ?obs a ont:PopulationObservation ;
       ont:city ?c ;
       ont:cityType ont:CityProper ;
       ont:recordType ont:CensusDeJureCompleteTabulation ;
       sdmx-dimension:refPeriod "2011"^^xsd:gYear ;
       ont:population ?population .
  ?c rdfs:label ?city ; schema:containedInPlace/rdfs:label ?country .
}
ORDER BY DESC(?population)
