# CQ4: How much bigger is the urban agglomeration than the city proper (same city, year and method)?
PREFIX ont:  <https://w3id.org/FAIR-course-UT/2026/groupNN/ont#>
PREFIX data: <https://w3id.org/FAIR-course-UT/2026/groupNN/data#>
PREFIX qb:   <http://purl.org/linked-data/cube#>
PREFIX sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#>
PREFIX schema: <https://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?city ?year ?cityProper ?agglomeration (ROUND(100 * ?agglomeration / ?cityProper) / 100 AS ?ratio)
WHERE {
  ?a ont:city ?c ; ont:cityType ont:UrbanAgglomeration ; ont:recordType ?m ;
     sdmx-dimension:refPeriod ?year ; ont:population ?agglomeration .
  ?p ont:city ?c ; ont:cityType ont:CityProper ; ont:recordType ?m ;
     sdmx-dimension:refPeriod ?year ; ont:population ?cityProper .
  ?c rdfs:label ?city .
}
ORDER BY DESC(?ratio)
LIMIT 15
