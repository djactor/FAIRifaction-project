data:observation-1 a ont:PopulationObservation ;
    qb:dataSet data:dataset ;
    sdmx-dimension:refPeriod "2023"^^xsd:gYear ;
    sdmx-dimension:sex sdmx-code:sex-T ;
    ont:city data:city-antwerpen ;
    ont:cityType ont:UrbanAgglomeration ;
    ont:population "541122"^^xsd:nonNegativeInteger ;
    ont:qualityNote "The 2023 urban agglomeration figure for Antwerpen (541122) is close to its city-proper figures and about half of the 2021 census agglomeration figure (1148671); the agglomeration boundary used in this source year is probably different."@en ;
