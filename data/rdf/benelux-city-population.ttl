data:dsd a qb:DataStructureDefinition ;
    qb:component data:dsd-component-1,
        data:dsd-component-2,
        data:dsd-component-3,
        data:dsd-component-4,
        data:dsd-component-5,
        data:dsd-component-6,
        data:dsd-component-7,
        data:dsd-component-8,
        data:dsd-component-9 .

data:dsd-component-1 a qb:ComponentSpecification ;
    qb:dimension ont:city ;
    qb:order 1 .

data:dsd-component-2 a qb:ComponentSpecification ;
    qb:dimension ont:cityType ;
    qb:order 2 .

data:dsd-component-3 a qb:ComponentSpecification ;
    qb:dimension ont:recordType ;
    qb:order 3 .

data:dsd-component-4 a qb:ComponentSpecification ;
    qb:dimension sdmx-dimension:refPeriod ;
    qb:order 4 .

data:dsd-component-5 a qb:ComponentSpecification ;
    qb:dimension sdmx-dimension:sex ;
    qb:order 5 .

data:dsd-component-6 a qb:ComponentSpecification ;
    qb:measure ont:population ;
    qb:order 6 .

data:dsd-component-7 a qb:ComponentSpecification ;
    qb:attribute ont:reliability ;
    qb:order 7 .

data:dsd-component-8 a qb:ComponentSpecification ;
    qb:attribute ont:sourceYear ;
    qb:order 8 .

data:dsd-component-9 a qb:ComponentSpecification ;
    qb:attribute ont:hasFootnote ;
    qb:order 9 .

